---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WritingList from '../components/WritingList.astro';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);

const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.publishedAt.replace(/\./g, '-');
  const dateB = b.data.publishedAt.replace(/\./g, '-');
  return new Date(dateB).getTime() - new Date(dateA).getTime();
});

const articles = sortedPosts.map((post) => ({
  slug: post.slug || post.id.replace(/\.[^/.]+$/, ''),
  title: post.data.title,
  date: post.data.publishedAt,
}));
---

<BaseLayout>
  <Header />
  <main class="main-column">
    <WritingList items={articles} />
  </main>
  <Footer />
</BaseLayout>
