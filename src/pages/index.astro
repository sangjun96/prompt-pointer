---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WritingList from '../components/WritingList.astro';
import WorkGrid from '../components/WorkGrid.astro';

const articles = [
  {
    slug: 'the-simplicity-of-stable-systems',
    title: 'The simplicity of stable systems',
    date: '2026.10',
  },
  {
    slug: 'design-patterns-in-collaborative-software',
    title: 'Design patterns in collaborative software',
    date: '2026.08',
  },
  {
    slug: 'designing-for-the-long-game',
    title: 'Designing for the long game',
    date: '2026.04',
  },
  {
    slug: 'reflections-on-code-and-quality',
    title: 'Reflections on code and quality',
    date: '2025.12',
  },
];

const projects = [
  {
    title: 'Linear Sync',
    description: 'Minimalist issue synchronization engine with deterministic conflict resolution.',
    href: 'https://github.com',
  },
  {
    title: 'Vercel SDK',
    description: 'Lightweight zero-dependency client toolkit for edge deployment workflows.',
    href: 'https://github.com',
  },
];
---

<BaseLayout>
  <Header />
  <main class="main-column">
    <Hero />
    <WritingList items={articles} />
    <WorkGrid projects={projects} />
  </main>
</BaseLayout>
