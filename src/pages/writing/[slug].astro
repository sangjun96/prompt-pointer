---
// src/pages/writing/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.slug || post.id.replace(/\.[^/.]+$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — prompt & pointer`} description={post.data.summary}>
  <Header />
  <main class="main-column">
    <article class="article-container">
      <header class="article-header">
        <a href="/#writing" class="back-link">← Writing</a>
        <h1 class="article-title">{post.data.title}</h1>
        <div class="article-meta">
          <time class="article-date">{post.data.publishedAt}</time>
        </div>
      </header>
      <div class="article-content">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .article-container {
    max-width: 100%;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .article-title {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .article-meta {
    margin-bottom: 3rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .article-content {
    color: var(--text-primary);
    line-height: 1.75;
    font-size: 1.0625rem;
  }

  .article-content :global(h2) {
    font-size: 1.375rem;
    font-weight: 500;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
    color: #C8C8D0;
  }

  .article-content :global(blockquote) {
    border-left: 2px solid var(--border-hover);
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: #C8C8D0;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: 500;
  }

  .article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    color: var(--text-primary);
  }
</style>
