---
// src/components/Header.astro
---

<header class="site-header">
  <a href="/" class="brand-link" aria-label="prompt & pointer home">
    <svg
      class="brand-mark"
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- 8-Ray Symmetrical Rounded Asterisk (*) -->
      <line x1="12" y1="2.5" x2="12" y2="21.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
      <line x1="2.5" y1="12" x2="21.5" y2="12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
      <line x1="5.28" y1="5.28" x2="18.72" y2="18.72" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
      <line x1="18.72" y1="5.28" x2="5.28" y2="18.72" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    </svg>
    <span class="brand-name">
      prompt <span class="brand-amp">&amp;</span> pointer
    </span>
  </a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    margin-bottom: 3.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8125rem;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    transition: opacity 0.15s ease;
  }

  .brand-link:hover {
    opacity: 0.92;
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--border-hover);
    outline-offset: 4px;
  }

  .brand-mark {
    width: 2rem; /* 32px */
    height: 2rem;
    flex-shrink: 0;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-link:hover .brand-mark {
    transform: rotate(45deg);
  }

  .brand-name {
    font-size: 1.4375rem; /* 23px */
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .brand-amp {
    color: var(--text-muted);
    font-weight: 400;
    margin: 0 0.08em;
  }

  /* Tablet */
  @media (max-width: 768px) {
    .site-header {
      margin-bottom: 2.75rem;
    }

    .brand-link {
      gap: 0.75rem;
    }

    .brand-mark {
      width: 1.75rem; /* 28px */
      height: 1.75rem;
    }

    .brand-name {
      font-size: 1.25rem; /* 20px */
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .site-header {
      margin-bottom: 2.25rem;
    }

    .brand-link {
      gap: 0.625rem;
    }

    .brand-mark {
      width: 1.625rem; /* 26px */
      height: 1.625rem;
    }

    .brand-name {
      font-size: 1.125rem; /* 18px */
    }
  }

  /* Small Mobile */
  @media (max-width: 380px) {
    .brand-mark {
      width: 1.5rem; /* 24px */
      height: 1.5rem;
    }

    .brand-name {
      font-size: 1.0625rem; /* 17px */
    }
  }
</style>
