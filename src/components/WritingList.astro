---
// src/components/WritingList.astro
export interface ArticleItem {
  slug: string;
  title: string;
  date: string;
}

interface Props {
  items: ArticleItem[];
}

const { items } = Astro.props;
---

<section id="writing" class="section-block">
  <h2 class="section-label">WRITING</h2>

  <ul class="writing-list">
    {
      items.map((post) => (
        <li class="writing-row">
          <a href={`/writing/${post.slug}`} class="writing-link">
            <span class="writing-title">{post.title}</span>
            <time class="writing-date">{post.date}</time>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .writing-list {
    list-style: none;
    border-top: none;
  }

  .writing-row {
    border-bottom: 1px solid var(--border-subtle);
    transition: opacity 0.2s ease;
  }

  .writing-list:hover .writing-row:not(:hover) {
    opacity: 0.45;
  }

  .writing-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.125rem 0;
  }

  .writing-title {
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .writing-date {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .writing-link {
      padding: 1rem 0;
      gap: 1rem;
    }

    .writing-title {
      font-size: 0.96875rem;
    }

    .writing-date {
      font-size: 0.8125rem;
    }
  }
</style>
