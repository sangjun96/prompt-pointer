---
// src/components/Footer.astro
---

<footer class="site-footer">
  <span class="footer-label">Contact</span>
  <span class="footer-email">sangjun.yoon96@gmail.com</span>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .footer-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .footer-email {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
    text-align: right;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .site-footer {
      padding-top: 1rem;
    }

    .footer-label {
      font-size: 0.6875rem;
    }

    .footer-email {
      font-size: 0.75rem;
    }
  }
</style>
